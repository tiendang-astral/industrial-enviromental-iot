# Cấu hình deploy production — copy sang .env.production rồi điền giá trị thật.
#
#   cp .env.example .env.production && $EDITOR .env.production && scripts/deploy-prod.sh
#
# .env.production KHÔNG được commit (đã có trong .gitignore).

# ============================================================ URL công khai
# Vite nướng biến VITE_* vào bundle lúc BUILD, không đọc được lúc chạy — đổi URL là phải
# build lại frontend (scripts/deploy-prod.sh --build).
#
# API để đường dẫn TƯƠNG ĐỐI được vì nginx của frontend proxy cùng origin sang backend
# (xem compose/nginx/spa.conf) — nhờ vậy không cần cấu hình CORS cho 2 SPA.
# Riêng WebSocket bắt buộc URL TUYỆT ĐỐI: @stomp/stompjs cần scheme ws://, không nhận đường dẫn.
TENANT_WEB_PORT=80
TENANT_API_BASE_URL=/api/v1
TENANT_WS_BASE_URL=ws://localhost/ws

ADMIN_WEB_PORT=8090
ADMIN_API_BASE_URL=/api/v1

# Chỉ cần khi có client gọi API từ origin KHÁC (app di động, tích hợp bên thứ ba). Hai SPA
# ở trên đi qua nginx cùng origin nên không dùng tới.
APP_CORS_ALLOWED_ORIGINS=

# ============================================================ Bí mật — ĐỔI HẾT
POSTGRES_USER=iiot
POSTGRES_PASSWORD=
POSTGRES_DB=iiot

INFLUX_USERNAME=iiot
INFLUX_PASSWORD=
INFLUX_ORG=iiot
INFLUX_BUCKET=raw
INFLUX_TOKEN=

MINIO_ROOT_USER=iiot
MINIO_ROOT_PASSWORD=

# openssl rand -base64 48
APP_JWT_SECRET=
# openssl rand -base64 32   — ĐỔI KHOÁ NÀY LÀ MẤT KHẢ NĂNG GIẢI MÃ credential external_source
# đã lưu. Sinh một lần rồi giữ nguyên, backup cẩn thận.
APP_ENCRYPTION_KEY=

# ============================================================ MQTT
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_PASSWORD=

# Tài khoản 2 service dùng để nối vào EMQX. Phải tạo trong EMQX Dashboard trước
# (compose đã đặt EMQX_ALLOW_ANONYMOUS=false). Gateway thật dùng tài khoản RIÊNG, kèm ACL
# giới hạn mỗi gateway chỉ đụng được topic của chính mac_address nó.
MQTT_SERVICE_USERNAME=iiot-service
MQTT_SERVICE_PASSWORD=

# ============================================================ Quy mô
# Ràng buộc: PROCESSING_REPLICAS x PROCESSING_CONCURRENCY <= KAFKA_TELEMETRY_PARTITIONS,
# vượt quá thì bản thừa không được giao partition nào và ngồi không.
#
# Partition CHỈ TĂNG ĐƯỢC, không giảm, và mỗi lần tăng có cửa sổ ngắn thứ tự bị đảo. Đặt dư
# ngay từ đầu (24 = đủ cho 6 bản x 4 thread ~ 18.000 điểm/giây theo số đo thật).
KAFKA_TELEMETRY_PARTITIONS=24
KAFKA_COMMAND_PARTITIONS=6
KAFKA_RETENTION_HOURS=168

INGESTION_REPLICAS=1
PROCESSING_REPLICAS=1
PROCESSING_CONCURRENCY=4

# Đo thật khi gánh tải: processing đỉnh ~407MB. Đừng đặt 512m.
BACKEND_MEMORY=1g
INGESTION_MEMORY=768m
PROCESSING_MEMORY=1g

# Cờ chống trùng nằm trong Redis. Ở 1.000 điểm/giây, TTL 6h ≈ 21 triệu key (~3GB).
# Tải cao thì hạ xuống 0.5 — dedup chỉ cần chặn message lặp do Kafka/MQTT gửi lại, chuyện đó
# xảy ra trong vài giây chứ không phải vài giờ.
DEDUP_TTL_HOURS=6

# ============================================================ Mail cảnh báo
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
ALERT_MAIL_FROM=alert@example.com

TZ=Asia/Ho_Chi_Minh
