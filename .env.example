# Cấu hình deploy production: copy sang .env.production, điền giá trị thật, chạy scripts/deploy-prod.sh
# .env.production không được commit.

# ============================================================ Địa chỉ truy cập
# Cổng web app người dùng
TENANT_WEB_PORT=80
# Đường dẫn API của app người dùng
TENANT_API_BASE_URL=/api/v1
# Địa chỉ WebSocket realtime, dùng IP/tên miền thật (đổi thì deploy lại với --build)
TENANT_WS_BASE_URL=ws://localhost/ws

# Cổng web trang quản trị
ADMIN_WEB_PORT=8090
# Đường dẫn API của trang quản trị
ADMIN_API_BASE_URL=/api/v1

# Địa chỉ người dùng gõ vào trình duyệt, cách nhau bằng dấu phẩy (sai là đăng nhập lỗi 403)
APP_CORS_ALLOWED_ORIGINS=http://localhost:31080,http://localhost:31090

# ============================================================ Dữ liệu khởi tạo
# Thêm ",classpath:db/dev-seed" để có sẵn tài khoản demo (admin/123456), chỉ dùng khi thử nghiệm
FLYWAY_LOCATIONS=classpath:db/migration

# ============================================================ Bí mật
# Tài khoản PostgreSQL
POSTGRES_USER=iiot
POSTGRES_PASSWORD=
POSTGRES_DB=iiot

# Tài khoản và bucket InfluxDB (lưu số đo)
INFLUX_USERNAME=iiot
INFLUX_PASSWORD=
INFLUX_ORG=iiot
INFLUX_BUCKET=raw
INFLUX_TOKEN=

# Tài khoản MinIO (lưu file)
MINIO_ROOT_USER=iiot
MINIO_ROOT_PASSWORD=

# Khoá ký token đăng nhập: openssl rand -base64 48
APP_JWT_SECRET=
# Khoá mã hoá mật khẩu nguồn dữ liệu ngoài: openssl rand -base64 32 (sinh một lần, không đổi)
APP_ENCRYPTION_KEY=

# ============================================================ MQTT
# Cổng gateway kết nối tới
MQTT_PORT=1883
# Cổng và mật khẩu admin trang EMQX Dashboard
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_PASSWORD=

# Địa chỉ MQTT gateway điền lên thiết bị, dùng IP/tên miền thật của VPS kèm MQTT_PORT
APP_MQTT_PUBLIC_URL=tcp://REPLACE_WITH_VPS_HOST:1883

# Tài khoản MQTT của ingestion/processing (toàn quyền)
MQTT_SERVICE_USERNAME=iiot-service
MQTT_SERVICE_PASSWORD=
# Mật khẩu tài khoản iiot-gateway mọi gateway dùng chung
MQTT_GATEWAY_PASSWORD=

# ============================================================ Quy mô
# Số partition Kafka (chỉ tăng được, không giảm)
KAFKA_TELEMETRY_PARTITIONS=24
KAFKA_COMMAND_PARTITIONS=6
# Số giờ Kafka giữ message
KAFKA_RETENTION_HOURS=168

# Số bản chạy song song; PROCESSING_REPLICAS x PROCESSING_CONCURRENCY <= KAFKA_TELEMETRY_PARTITIONS
INGESTION_REPLICAS=1
PROCESSING_REPLICAS=1
PROCESSING_CONCURRENCY=4

# Giới hạn RAM mỗi service (processing đỉnh ~407MB, đừng đặt 512m)
BACKEND_MEMORY=1g
INGESTION_MEMORY=768m
PROCESSING_MEMORY=1g

# Số giờ giữ cờ chống trùng message trong Redis (tải cao thì hạ xuống 0.5)
DEDUP_TTL_HOURS=6

# ============================================================ Mail cảnh báo
# Máy chủ SMTP gửi mail cảnh báo
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Người gửi mail cảnh báo (giữ dấu nháy)
ALERT_MAIL_FROM="IIoT Alert <alert@example.com>"

# Múi giờ
TZ=Asia/Ho_Chi_Minh
